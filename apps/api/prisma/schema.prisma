datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  password          String
  name              String
  role              Role          @default(EMPLOYEE)
  isActive          Boolean       @default(true)
  customPermissions String[]      @default([])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  authSessions      AuthSession[]
}

model AuthSession {
  // Callers always pass id explicitly (signed into the JWT sid claim in the
  // same operation) — the cuid() default is a safety net, not the real path.
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Tài khoản SQL Server dùng để đọc SAP HANA qua linked server hana_mc.
/// Địa chỉ máy chủ lấy từ biến môi trường SAP_SQL_HOST/SAP_SQL_PORT, không lưu ở đây.
/// Tối đa 1 dòng isActive = true, bảo đảm bằng partial unique index viết tay trong migration.
model SapConnection {
  id                String    @id @default(cuid())
  username          String    @unique
  /// AES-256-GCM, dạng "iv.tag.ct" (base64), khóa SAP_CREDENTIAL_KEY
  passwordEncrypted String
  isActive          Boolean   @default(false)
  lastTestAt        DateTime?
  lastTestOk        Boolean?
  updatedById       String?
  updatedByName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SapBrand {
  code      String     @id
  name      String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  stores    SapStore[]

  @@map("sap_brands")
}

model SapStore {
  code           String    @id
  name           String
  brandCode      String?
  brand          SapBrand? @relation(fields: [brandCode], references: [code], onDelete: SetNull)
  sapInactive    Boolean   @default(false)
  isActiveSales  Boolean   @default(false)
  isActiveReturn Boolean   @default(false)
  syncedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([brandCode])
  @@index([isActiveSales])
  @@index([isActiveReturn])
  @@index([sapInactive])
  @@map("sap_stores")
}

model SapQueryDef {
  key                  String            @id /// Khóa định danh chuẩn (1 trong 25 khóa: funnel, t1..ap, chain_po..chain_ap, ret_so..ret_whs, old_sos_1..old_sos_5)
  flow                 String            /// 'ban' | 'tra'
  stage                String            /// 'list' | 'chain' | 'main' | 'old_discovery'
  sortOrder            Int               /// Thứ tự 1..25 theo đúng tài liệu
  title                String            /// Nhãn tiếng Việt dễ hiểu cho IT
  description          String            /// Mô tả vai trò nghiệp vụ và nguồn bảng
  impactBadges         String[]          @default([]) /// Danh sách vùng UI/KPI bị ảnh hưởng
  allowedPlaceholders  String[]          @default([]) /// Danh sách biến runtime bắt buộc giữ (vd: ['{d}', '{br}'])
  requiredColumns      String[]          @default([]) /// Hợp đồng cột bắt buộc (Core Columns)
  baselineColumns      String[]          @default([]) /// Toàn bộ cột trả về của câu gốc v1 (kể cả cột ẩn như PO DocEntry, Kho PO min/max)
  dedupKeys            String[]          @default([]) /// Khóa khử trùng theo đặc tả 12.5
  supportsExtraColumns Boolean           @default(true)
  autoDateUpper        Boolean           @default(true) /// Tự đổi "DocDate" >= '{d}' thành BETWEEN '{d}' AND '{date_to}'
  defaultSql           String            /// Câu Full SQL gốc (Seed v1) dùng để đối chiếu & khôi phục
  currentVersionNo     Int               @default(1)
  lastTestedSqlHash    String?           /// SHA-256 của câu SQL đã chuẩn hóa vượt qua Review & Validate gần nhất
  lastTestedAt         DateTime?
  lastTestedById       String?
  lastTestRowCount     Int?
  lastTestDurationMs   Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  versions             SapQueryVersion[]
  audits               SapQueryAudit[]

  @@index([flow, sortOrder])
  @@map("sap_query_defs")
}

model SapQueryVersion {
  id          String      @id @default(cuid())
  queryKey    String
  query       SapQueryDef @relation(fields: [queryKey], references: [key], onDelete: Cascade)
  versionNo   Int
  sqlText     String
  sqlHash     String
  changeNote  String
  createdById String?
  createdBy   String?
  createdAt   DateTime    @default(now())

  @@unique([queryKey, versionNo])
  @@index([queryKey, versionNo])
  @@map("sap_query_versions")
}

model SapQueryAudit {
  id          String      @id @default(cuid())
  queryKey    String
  query       SapQueryDef @relation(fields: [queryKey], references: [key], onDelete: Cascade)
  action      String      /// 'review' | 'publish' | 'rollback' | 'reset_default'
  fromVersion Int?
  toVersion   Int?
  beforeSql   String?
  afterSql    String?
  changeNote  String?
  actorId     String?
  actorName   String?
  createdAt   DateTime    @default(now())

  @@index([queryKey, createdAt])
  @@map("sap_query_audits")
}
